  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Existing primary action treatment.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Review candidate</button>",
      "css": ".ds-button-primary{font:14px/1.45 var(--font);border:1px solid var(--border-strong);background:var(--surface);color:var(--ink);border-radius:7px;padding:6px 12px;min-height:36px;cursor:pointer;transition:background-color var(--motion-fast) ease,border-color var(--motion-fast) ease,color var(--motion-fast) ease,box-shadow var(--motion-fast) ease;background:var(--accent);border-color:var(--accent);color:var(--on-accent);}.ds-button-primary:hover{filter:brightness(.94);}.ds-button-primary:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}.ds-button-primary:active{box-shadow:inset 0 0 0 2px var(--border-strong);}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none!important;animation:none!important;transform:none!important;}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Existing secondary action treatment.",
      "html": "<button class=\"ds-button-secondary\" type=\"button\">Reset</button>",
      "css": ".ds-button-secondary{font:14px/1.45 var(--font);border:1px solid var(--border-strong);background:var(--surface);color:var(--ink);border-radius:7px;padding:6px 12px;min-height:36px;cursor:pointer;transition:background-color var(--motion-fast) ease,border-color var(--motion-fast) ease,color var(--motion-fast) ease,box-shadow var(--motion-fast) ease;}.ds-button-secondary:hover{background:var(--surface-2);}.ds-button-secondary:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}.ds-button-secondary:active{box-shadow:inset 0 0 0 2px var(--border-strong);}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none!important;animation:none!important;transform:none!important;}}"
    },
    {
      "name": "Theme / Icon Button",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "Compact secondary action with an inline SVG icon.",
      "html": "<button class=\"ds-icon-button\" type=\"button\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 1.5v11a5.5 5.5 0 0 1 0-11z\" fill=\"currentColor\"/></svg><span>Theme</span></button>",
      "css": ".ds-icon-button{font:14px/1.45 var(--font);border:1px solid var(--border-strong);background:var(--surface);color:var(--ink);border-radius:7px;padding:6px 12px;min-height:36px;cursor:pointer;transition:background-color var(--motion-fast) ease,border-color var(--motion-fast) ease,color var(--motion-fast) ease,box-shadow var(--motion-fast) ease;display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-color:var(--border);border-radius:8px;color:var(--ink-2);}.ds-icon-button:hover{background:var(--surface-2);}.ds-icon-button:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}.ds-icon-button:active{box-shadow:inset 0 0 0 2px var(--border-strong);}@media(prefers-reduced-motion:reduce){.ds-icon-button{transition:none!important;animation:none!important;transform:none!important;}}"
    },
    {
      "name": "Filter Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Native select with the established uppercase filter caption.",
      "html": "<label class=\"ds-field\">Time range<select class=\"ds-field-select\"><option>Monitoring period</option><option>Full history</option></select></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:3px;font:600 11px/1.45 var(--font);letter-spacing:.04em;text-transform:uppercase;color:var(--ink-2);}.ds-field-select{font:14px/1.45 var(--font);letter-spacing:normal;text-transform:none;color:var(--ink);background:var(--surface);border:1px solid var(--border-strong);border-radius:7px;padding:6px 8px;min-height:36px;max-width:200px;transition:background-color var(--motion-fast) ease;}.ds-field-select:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}@media(prefers-reduced-motion:reduce){.ds-field,.ds-field-select{transition:none!important;animation:none!important;transform:none!important;}}"
    },
    {
      "name": "Current Navigation",
      "kind": "nav",
      "refersTo": "navigation-current",
      "description": "Static current-link treatment; the live application additionally animates its indicator.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Dashboard preview\"><a class=\"ds-nav-link\" href=\"#overview\" aria-current=\"page\"><svg class=\"ds-nav-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/></svg><span class=\"ds-nav-copy\">Overview<small class=\"ds-nav-sub\">Campus health</small></span></a></nav>",
      "css": ".ds-nav{max-width:195px;}.ds-nav-link{display:flex;align-items:center;gap:10px;padding:12px 10px;border:1px solid var(--border);border-radius:9px;font:500 13px/1.45 var(--font);color:var(--accent);background:var(--accent-wash);box-shadow:inset 3px 0 var(--accent);text-decoration:none;}.ds-nav-icon{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.7;transition:transform 180ms ease;}.ds-nav-copy{display:flex;flex-direction:column;gap:3px;}.ds-nav-sub{font-size:11px;font-weight:400;color:var(--muted);}.ds-nav-link:hover .ds-nav-icon{transform:scale(1.08);}.ds-nav-link:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}.ds-nav-link:active{transform:scale(.975);}@media(prefers-reduced-motion:reduce){.ds-nav,.ds-nav-copy,.ds-nav-icon,.ds-nav-link,.ds-nav-sub{transition:none!important;animation:none!important;transform:none!important;}}"
    },
    {
      "name": "Type Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Fixed category color and symbol accompany a readable label.",
      "html": "<span class=\"ds-chip\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><circle cx=\"6\" cy=\"6\" r=\"4\" fill=\"var(--t-point)\"/></svg>Point</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:5px;padding:1px 8px 1px 6px;border-radius:999px;background:var(--surface-2);color:var(--ink-2);font:12px/1.45 var(--font);white-space:nowrap;border:1px solid var(--border);}@media(prefers-reduced-motion:reduce){.ds-chip{transition:none!important;animation:none!important;transform:none!important;}}"
    },
    {
      "name": "Evidence Card",
      "kind": "card",
      "refersTo": "card",
      "description": "A titled evidence region with supporting context.",
      "html": "<section class=\"ds-card\"><h3 class=\"ds-card-title\">Meter evidence</h3><p class=\"ds-card-sub\">Observed readings and available context</p></section>",
      "css": ".ds-card{font:14px/1.45 var(--font);background:var(--surface);color:var(--ink);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);padding:22px;min-width:0;}.ds-card-title{margin:0;font-size:16px;font-weight:620;}.ds-card-sub{margin:2px 0 0;color:var(--muted);font-size:12px;line-height:1.6;}@media(max-width:700px){.ds-card{padding:14px;}}@media(prefers-reduced-motion:reduce){.ds-card,.ds-card-sub,.ds-card-title{transition:none!important;animation:none!important;transform:none!important;}}"
    },
    {
      "name": "Linked Metric Card",
      "kind": "custom",
      "refersTo": "metric-card",
      "description": "An actionable summary with value, supporting note and compact accent icon.",
      "html": "<a class=\"ds-metric\" href=\"#investigate\"><span class=\"ds-metric-heading\"><span class=\"ds-metric-label\">Events requiring review</span><span class=\"ds-metric-symbol\"><svg class=\"ds-metric-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 5H5v16h14V5h-4M9 3h6v4H9zM8 12h8M8 16h5\"/></svg></span></span><div class=\"ds-metric-value\">—</div><div class=\"ds-metric-note\">In the selected scope</div></a>",
      "css": ".ds-metric{font:14px/1.45 var(--font);background:var(--surface);color:var(--ink);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);padding:22px;min-width:0;display:block;text-decoration:none;max-width:290px;cursor:pointer;transition:border-color var(--motion-fast) ease;}.ds-metric-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;}.ds-metric-label{color:var(--ink-2);font-size:12px;line-height:1.5;}.ds-metric-symbol{display:inline-flex;align-items:center;justify-content:center;flex:none;width:30px;height:30px;border-radius:8px;color:var(--accent);background:var(--accent-wash);}.ds-metric-icon{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;}.ds-metric-value{font-size:26px;font-weight:640;letter-spacing:-.02em;margin:10px 0;}.ds-metric-note{font-size:12px;color:var(--muted);}.ds-metric:hover{border-color:var(--accent);}.ds-metric:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}@media(max-width:700px){.ds-metric{padding:14px;}.ds-metric-value{font-size:21px;}}@media(prefers-reduced-motion:reduce){.ds-metric,.ds-metric-heading,.ds-metric-icon,.ds-metric-label,.ds-metric-note,.ds-metric-symbol,.ds-metric-value{transition:none!important;animation:none!important;transform:none!important;}}"
    },
    {
      "name": "Evidence Disclosure",
      "kind": "custom",
      "refersTo": "disclosure",
      "description": "Native expandable supporting evidence with a focus-aware border.",
      "html": "<details class=\"ds-disclosure\"><summary class=\"ds-disclosure-summary\">Additional evidence</summary><p class=\"ds-disclosure-copy\">Context is available separately from the main evidence.</p></details>",
      "css": ".ds-disclosure{font:14px/1.45 var(--font);border:1px solid var(--border);border-radius:10px;padding:4px 18px;background:var(--surface);color:var(--ink-2);transition:border-color var(--motion-fast) ease;}.ds-disclosure-summary{cursor:pointer;font-size:13px;font-weight:600;padding:10px 0;}.ds-disclosure-summary::marker{color:var(--accent);}.ds-disclosure-summary:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}.ds-disclosure:has(>summary:focus-visible){border-color:var(--focus);}.ds-disclosure[open]>.ds-disclosure-summary{margin-bottom:16px;}.ds-disclosure[open]>.ds-disclosure-copy{animation:ds-disclosure-enter 180ms ease-out;}@keyframes ds-disclosure-enter{from{opacity:.7;transform:translateY(3px);}to{opacity:1;transform:translateY(0);}}@media(prefers-reduced-motion:reduce){.ds-disclosure,.ds-disclosure-copy,.ds-disclosure-summary{transition:none!important;animation:none!important;transform:none!important;}}"
    },
    {
      "name": "Overview Metric Strip",
      "kind": "custom",
      "refersTo": "metric-strip",
      "description": "Compact labeled metrics; headlines keep their filter scope when chart inspection changes.",
      "html": "<dl class=\"ds-metric-strip\"><div class=\"ds-strip-item\"><dt>Candidate events</dt><dd>—</dd></div><div class=\"ds-strip-item\"><dt>Largest deviation</dt><dd>—</dd></div></dl>",
      "css": ".ds-metric-strip{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;padding:12px 0;margin:0;border-block:1px solid var(--border-strong);font:14px/1.45 var(--font);color:var(--ink);}.ds-strip-item{padding:8px 16px;}.ds-strip-item+div{border-left:1px solid var(--border);}.ds-strip-item dt{font-size:12px;color:var(--ink-2);}.ds-strip-item dd{margin:6px 0;font-size:26px;font-weight:640;letter-spacing:-.02em;font-variant-numeric:tabular-nums;}@media(max-width:700px){.ds-strip-item{padding:8px;}.ds-strip-item dd{font-size:23px;}}"
    },
    {
      "name": "Desktop Directory Comparison",
      "kind": "custom",
      "refersTo": "desktop-comparison",
      "description": "Native comparison rows at 1440px and wider. Real model coverage, available phase measurements and persisted local review progress remain distinct; narrower layouts retain existing cards.",
      "html": "<div class=\"ds-comparison\"><table><caption>Meter comparison · saved reviews in this browser only</caption><thead><tr><th scope=\"col\">Meter</th><th scope=\"col\">Candidates</th><th scope=\"col\">Saved reviews</th></tr></thead><tbody><tr><th scope=\"row\">—</th><td>—</td><td>—</td></tr></tbody></table></div>",
      "css": ".ds-comparison{font:13px/1.5 var(--font);color:var(--ink);overflow:auto;}.ds-comparison table{width:100%;border-collapse:collapse;}.ds-comparison caption{text-align:left;padding:0 0 12px;color:var(--ink-2);font-size:12px;}.ds-comparison th,.ds-comparison td{text-align:left;padding:14px 12px;border-bottom:1px solid var(--border);font-variant-numeric:tabular-nums;}.ds-comparison thead{background:var(--surface-2);color:var(--ink-2);}"
    },
    {
      "name": "Keyboard Chart Inspector",
      "kind": "custom",
      "refersTo": "chart-inspector",
      "description": "Native disclosure and keyboard range control outside the SVG image. A live readout retains exact supplied measurements, raw thresholds/scores and observation quality; gaps stay unavailable.",
      "html": "<details class=\"ds-inspector\"><summary>Inspect hourly values</summary><label>Inspection hour <input type=\"range\" min=\"0\" max=\"1\" value=\"0\"></label><p role=\"status\">Selected hour measurements appear here.</p></details>",
      "css": ".ds-inspector{font:13px/1.5 var(--font);color:var(--ink);border-top:1px solid var(--border);padding:8px 0;}.ds-inspector summary{color:var(--accent);font-weight:600;cursor:pointer;}.ds-inspector input{accent-color:var(--accent);}.ds-inspector input:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}"
    }
  ],
  "narrative": {
    "northStar": "Facilities Operations Console",
    "overview": "The Facilities Operations Console is calm, precise and approachable. Operations Green identifies actions and the current location; Soft Stone surfaces separate controls, evidence and supporting context. Dense information stays readable through clear headings, whitespace, cards and disclosures.\n\nComponents are restrained and practical. Tonal layering and faint ambient shadows give the workspace enough depth to distinguish regions without competing with charts or event tables. The visual character is established by the current implementation, not a replacement identity.\n\nOverview metrics use a compact divided strip. Event evidence uses open sections, with legends and explicit chart dates above plots. The mobile menu opens on request, and supporting detail follows the primary evidence.\n\nThis record captures the final CSS cascade and computed light/dark themes at the documented revision. Earlier blue shell declarations are superseded by green operational overrides; Signal Blue still belongs to the chart taxonomy. Implementation sources are `css/styles.css`, `index.html`, `js/ui.js`, `js/util.js`, `js/charts.js` and the section renderers.\n\nAt 1440px and wider, operational worklists and primary model charts use open sections; native directory comparison tables replace repeated meter/building cards. Navigation groups operational work separately from data tools. Narrower layouts retain their existing card/menu functionality. Synthetic Demo is the consistent source label. Native keyboard inspection exposes exact supplied hourly model values and quality without changing model facts. Focused meter profiles use one context plot with a direct event-review action; saved-window dates remain separate.",
    "keyCharacteristics": [
      "Operations Green for actions and navigation; separate categorical and severity colors.",
      "System typography with compact labels, strong section headings and readable evidence.",
      "Soft Stone surfaces, gently rounded containers and faint ambient shadows.",
      "Persistent desktop navigation and a compact mobile menu.",
      "Tables, custom SVG charts and disclosures organize detailed evidence."
    ],
    "rules": [
      {
        "name": "The Evidence Color Rule",
        "body": "Preserve the separate meanings of action color, anomaly type, severity, measurement quality and review status; never use one as a substitute for another.",
        "section": "colors"
      },
      {
        "name": "The Type Continuity Rule",
        "body": "Extend the system-font hierarchy; do not introduce a decorative display face for routine console screens.",
        "section": "typography"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "Keep card shadows ambient; use boundaries and surface tones to separate routine evidence.",
        "section": "elevation-depth"
      }
    ],
    "dos": [
      "Do use existing theme variables and the final CSS cascade when extending the interface.",
      "Do pair anomaly colors with their fixed symbols and severity colors with icons and labels.",
      "Do keep measured demand solid, expected demand dashed and forecast bands visually subordinate.",
      "Do retain keyboard focus, native links and controls, reduced-motion handling and local table scrolling.",
      "Do use section headings, concise summaries and disclosures to organize dense evidence."
    ],
    "donts": [
      "Don't reuse severity colors as decoration or treat review-status pills as severity indicators.",
      "Don't restore the superseded blue shell palette or the old horizontal desktop tab strip by copying early CSS declarations.",
      "Don't introduce external display fonts, ornamental imagery or exaggerated elevation into the existing console.",
      "Don't encode data distinctions with color alone or infer a confirmed diagnosis from a visual highlight.",
      "Don't claim an accessibility certification or responsive behavior beyond the checks actually performed."
    ]
  }
